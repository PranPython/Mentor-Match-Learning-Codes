from tkinter import *

scr = Tk()
scr.geometry("605x125")

def convert():
    weight_inp = float(weight.get())
    g_conv = weight_inp * 1000
    p_conv = weight_inp * 2.20462
    o_conv = weight_inp * 35.274
    gtxt.delete("1.0",END)
    gtxt.insert(END,g_conv)
    ptxt.delete("1.0",END)
    ptxt.insert(END,p_conv)
    otxt.delete("1.0",END)
    otxt.insert(END,o_conv)




entr_weight = Label(scr,text = "Enter the weight in KGs",font =("Times new roman",15),fg = "Black")
entr_weight.grid(row = 0,column = 0)

weight = Entry(scr,font = ("Times new roman",15),fg = "black")
weight.grid(row = 0,column = 1)

conv = Button(scr,text = "Convert",font = ("Times new roman",17),fg = "black", command = convert)
conv.grid(row = 0,column = 2)



g = Label(scr,text = "Grams",font = ("Times new roman",15),fg = "Black")
g.grid(row = 1,column = 0)

p = Label(scr,text = "Pounds",font = ("Times new roman",15),fg = "Black")
p.grid(row = 1,column = 1)

o = Label(scr,text = "Ounce",font = ("Times new roman",15),fg = "Black")
o.grid(row = 1,column = 2)

gtxt = Text(scr,font = ("Times new roman",15),fg = "Black",height = 1,width = 20) 
gtxt.grid(row = 2,column = 0)

ptxt = Text(scr,font = ("Times new roman",15),fg = "Black",height = 1,width = 20) 
ptxt.grid(row = 2,column = 1)

otxt = Text(scr,font = ("Times new roman",15),fg = "Black",height = 1,width = 20) 
otxt.grid(row = 2,column = 2)






scr.mainloop()
