from tkinter import *
import random as rd

scr = Tk()
scr.geometry("750x500")

Score_plyr = 0
Score_comp = 0
Options = [("Rock",0),("Paper",1),("Scissors",2)]

# Computer wins
def comp_win():
    global Score_comp , Score_plyr
    Score_comp += 1
    res.config(text = "You lose")
    comp_scr_lbl.config(text = "Computer Score:" + str(Score_comp))
    me_scr_lbl.config(text = "Your Score:" + str(Score_plyr))

# Computer loses
def comp_lose():
    global Score_comp , Score_plyr
    Score_plyr += 1
    res.config(text = "You win")
    comp_scr_lbl.config(text = "Computer Score:" + str(Score_comp))
    me_scr_lbl.config(text = "Your Score:" + str(Score_plyr))

# Computer Ties
def comp_tie():
    global Score_comp , Score_plyr
    res.config(text = "Tie")
    comp_scr_lbl.config(text = "Computer Score:" + str(Score_comp))
    me_scr_lbl.config(text = "Your Score:" + str(Score_plyr))

# Computer Choice
def comp_choice():
    return rd.choice(Options)

# Player Choice
def plyr_choice(plyr_inp):
    global Score_comp, Score_plyr, me_slct_lbl, comp_slct_lbl
    comp_inp = comp_choice()
    me_slct_lbl.config(text = "Your Selected:"+ plyr_inp[0])
    comp_slct_lbl.config(text = "Computer Selected:"+ comp_inp[0])
    if comp_inp == plyr_inp:
        comp_tie()
    if plyr_inp[1] == 0:
        if comp_inp[1] == 1:
            comp_win()
        elif comp_inp[1] == 2:
            comp_lose()

    elif plyr_inp[1] == 1:
            if comp_inp[1] == 2:
                comp_win()
            elif comp_inp[1] == 0:
                comp_lose()

    elif plyr_inp[1] == 2:
            if comp_inp[1] == 0:
                comp_win()
            elif comp_inp[1] == 1:
                comp_lose()



